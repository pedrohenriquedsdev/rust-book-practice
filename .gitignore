# --- Rust/Cargo Padrão ---
# Ignora toda a pasta de compilação (onde ficam os executáveis .exe, .dll, .so)
/target/

# --- Compilação manual com rustc (capítulos iniciais, antes do Cargo) ---
# Binários e símbolos de debug gerados quando se compila direto com `rustc`
# (fora da pasta /target/, que só existe em projetos Cargo)
*.exe
*.pdb

# --- Ferramentas de Desenvolvimento e Profiling ---
# Arquivos gerados por testes, benchmarks ou profiling (como o cargo-tarpaulin ou perf)
*.rs.bk
cobertura.xml
*.profraw

# --- Documentação ---
# Se você gerar documentação local com cargo doc
/doc/

# --- IDEs e Editores de Código ---
# VS Code
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# IntelliJ / RustRover / CLion
.idea/
*.iml

# Subleme Text
*.sublime-project
*.sublime-workspace

# Ficheiros temporários do Vim/Emacs
*~
*.swp
*.swo

# --- Arquivos de Sistema e Log ---
.DS_Store
Thumbs.db
*.log

# --- Variáveis de Ambiente ---
# Se o seu projeto usa arquivos para guardar chaves secretas ou senhas
.env
.env.*
!.env.example
